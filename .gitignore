# ── Raw / source data — NEVER commit (loads via src/data_access.py at build time)
*.parquet
*.zip
project_data/
data/raw/

# ── Secrets — NEVER commit
.streamlit/secrets.toml
*.env
.env

# ── Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Sentiment build cache (regenerated locally; not needed by the app)
results/**/cache/
*.pkl

# Note: results/data/*.csv and results/tables/*.csv ARE committed on purpose —
# the deployed app reads these precomputed artifacts and cannot rebuild them
# on the Streamlit free tier.
